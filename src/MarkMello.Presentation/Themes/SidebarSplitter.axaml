<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style Selector="GridSplitter.mm-sidebar-splitter">
    <Setter Property="Width" Value="8" />
    <Setter Property="Margin" Value="-4,0" />
    <Setter Property="Cursor" Value="SizeWestEast" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Template">
      <ControlTemplate>
        <Grid Background="Transparent">
          <!-- Overlay the sidebar's existing 1px border; keep the hit area invisible. -->
          <Border Width="1"
                  Margin="3,0,0,0"
                  HorizontalAlignment="Left"
                  Background="Transparent" />
        </Grid>
      </ControlTemplate>
    </Setter>
  </Style>
  <!-- Splitter на левой границе правой панели: 1px подсветка ложится на её рамку,
       то есть сразу справа от границы колонок, а не слева от неё. -->
  <Style Selector="GridSplitter.mm-sidebar-splitter.mm-splitter-right /template/ Border">
    <Setter Property="Margin" Value="4,0,0,0" />
  </Style>
  <Style Selector="GridSplitter.mm-sidebar-splitter:pointerover /template/ Border">
    <Setter Property="Background" Value="{DynamicResource MmAccentBrush}" />
  </Style>
  <Style Selector="GridSplitter.mm-sidebar-splitter.dragging /template/ Border">
    <Setter Property="Background" Value="{DynamicResource MmAccentBrush}" />
  </Style>
</Styles>
