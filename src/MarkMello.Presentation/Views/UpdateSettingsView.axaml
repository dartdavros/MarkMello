<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MarkMello.Presentation.ViewModels"
             xmlns:views="using:MarkMello.Presentation.Views"
             x:Class="MarkMello.Presentation.Views.UpdateSettingsView"
             x:DataType="vm:ShellViewModel">
  <Border Classes="mm-setting-row">
    <StackPanel Spacing="12">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
        <StackPanel Spacing="2">
          <TextBlock Classes="mm-setting-label" Text="{Binding UpdatesLabel}" />
          <TextBlock Classes="mm-setting-hint" Text="{Binding UpdatesHint}" />
        </StackPanel>
        <TextBlock Grid.Column="1" Classes="mm-setting-meta" Text="{Binding UpdateStateBadge}" />
      </Grid>

      <views:AutomaticUpdatePreferenceView DataContext="{Binding AutomaticUpdateSettings}" />

      <StackPanel Spacing="4">
        <TextBlock Classes="mm-setting-label" FontSize="{DynamicResource MmUiFontSize12}"
                   FontWeight="SemiBold" Text="{Binding UpdateStatusTitle}" TextWrapping="Wrap" />
        <TextBlock Classes="mm-setting-body" Text="{Binding UpdateStatusMessage}" TextWrapping="Wrap" />
      </StackPanel>

      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Classes="mm-dialog-secondary" Content="{Binding CheckForUpdatesLabel}"
                Command="{Binding CheckForUpdatesCommand}" />
        <Button Classes="mm-dialog-primary" Content="{Binding DownloadUpdateLabel}"
                Command="{Binding DownloadUpdateCommand}" IsVisible="{Binding CanDownloadAvailableUpdate}" />
      </StackPanel>

      <Button Classes="mm-dialog-secondary" Content="{Binding DownloadedUpdateActionLabel}"
              Command="{Binding OpenDownloadedUpdateCommand}" IsVisible="{Binding CanOpenDownloadedUpdate}" />
    </StackPanel>
  </Border>
</UserControl>
